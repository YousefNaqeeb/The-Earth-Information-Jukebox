PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/lightning.sqlite
GRANULE_CACHE_DIR=./data/granules

# Verified against NASA CMR on 2026-11-15; the service reads version at runtime.
NASA_CMR_COLLECTION_ID=C3838944284-GHRC_DAAC
NASA_CMR_PAGE_SIZE=2000
NASA_S3_CREDENTIALS_URL=https://data.ghrc.earthdata.nasa.gov/s3credentials
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Inspect an authorized file with:
# python3 scripts/read_lis.py --inspect /path/to/file.nc
# Then set actual names from that file; don't copy names from another product version.
ISS_LIS_VARIABLE_MAP=
# Example shape only (replace every name with ones verified in your downloaded file):
# {"timestamp":"actual_time_variable","latitude":"lightning_flash_lat","longitude":"lightning_flash_lon","measurements":["actual_measurement_variable"]}

# Ingestion is intentionally bounded; set 0 only when you intend to ingest all matches.
INGEST_MAX_GRANULES=20
INGEST_FORMAT=nc
PYTHON_EXECUTABLE=python3
CORS_ORIGINS=*
